{
  "name": "mtjob-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MTJOB backend — task/diem, cham cong, kho tri thuc (Gemini), bao cao (Node + Google Sheets)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup-db": "tsx scripts/setup-db.ts",
    "sync-members": "tsx scripts/sync-members.ts",
    "sync-catalog": "tsx scripts/sync-catalog.ts",
    "gemini-auth": "tsx scripts/gemini-auth.ts",
    "backfill-dayfraction": "tsx scripts/backfill-dayfraction.ts",
    "migrate-customer-notes": "tsx scripts/migrate-customer-notes.ts",
    "job:daily": "tsx src/jobs/runDaily.ts",
    "job:monthly": "tsx src/jobs/runMonthly.ts"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
