# ─────────────────────────────────────────────────────────────
# MTJOB — biến môi trường (copy sang server/.env)
# ─────────────────────────────────────────────────────────────

# ===== Server =====
PORT=8080
# HOST=127.0.0.1   # bật khi chạy sau reverse proxy (Apache/Nginx) để chỉ nghe nội bộ
NODE_ENV=development
APP_TZ=Asia/Ho_Chi_Minh

# JWT
JWT_SECRET=doi-thanh-mot-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=7d

# Tài khoản admin khởi tạo (script setup-db sẽ tạo nếu chưa có)
ADMIN_EMAIL=admin@mtjob.local
ADMIN_PASSWORD=Admin@2026

# ===== CSDL Postgres =====
# Lấy từ Neon (Vercel → Storage → Create Database) / Supabase / Postgres bất kỳ.
# Vercel + Neon sẽ tự thêm biến này khi connect database vào project.
DATABASE_URL=

# (Đã bỏ SHEET_HR_SOURCE_ID/GID từ 29/7/2026 — nhân sự và lương nhập thẳng trong màn
#  Quản trị, setup-db seed danh sách ban đầu từ snapshot nhúng sẵn trong code.)

# ===== Sheet bảng điểm task (TUỲ CHỌN — nút "Đồng bộ bảng điểm"; điểm = cột EXPERT) =====
# GIDS dạng "gid:PREFIX,...". Mở từng tab trên trình duyệt để lấy gid (#gid=... trong URL).
SHEET_TASKS_SOURCE_ID=1C0-uJxZwzaBWWDqSbwPhJI0YJEPBxbOwTOBflATMcJc
SHEET_TASKS_SOURCE_GIDS=0:ADS

# ===== Gemini (trợ lý chat — TUỲ CHỌN, để trống thì chat chạy chế độ heuristic) =====
# Cách 1 (OAuth đăng nhập Google):
#   1. Tạo OAuth Client ID kiểu "Web application" trong Google Cloud Console.
#   2. Thêm Authorized redirect URI: http://localhost:8080/api/oauth2/callback (đổi domain khi prod).
#   3. Chạy:  npm run gemini-auth --prefix server  -> mở URL -> đồng ý
#      -> Google redirect về /api/oauth2/callback và hiển thị GEMINI_OAUTH_REFRESH_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:8080/api/oauth2/callback
GEMINI_OAUTH_REFRESH_TOKEN=

# Cách 2 (API key AI Studio — đơn giản nhất). Để trống nếu dùng OAuth ở trên.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cách 3 (chạy local trên Mac qua cliproxyapi / proxy AI cục bộ):
# GEMINI_BASE_URL=http://localhost:8317/v1beta

# ===== Web Push (VAPID) — sinh bằng: npx web-push generate-vapid-keys =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# PHẢI là địa chỉ liên hệ THẬT: https://<tên miền> hoặc mailto: với tên miền có thật.
# Apple (iPhone) trả lỗi 403 nếu sai — Google thì bỏ qua, nên rất dễ tưởng đã chạy tốt.
# Bỏ trống hoặc khai sai thì máy chủ tự dùng https://job.mtdigital.vn.
VAPID_SUBJECT=https://job.mtdigital.vn

# ===== Vercel Blob (lưu ảnh/PDF của Lưu ý KH) =====
# Tạo Blob store trên Vercel Dashboard → Storage → Create Blob Store.
# Vercel tự inject khi kết nối store vào project; chạy local thì thêm tay vào server/.env.
mt_READ_WRITE_TOKEN=
mt_STORE_ID=

# ===== Vercel Cron (chỉ cần khi deploy Vercel) =====
# Chuỗi ngẫu nhiên; Vercel tự gắn "Authorization: Bearer <CRON_SECRET>" khi gọi /api/jobs/*
CRON_SECRET=

# ===== Frontend (web/.env — Vite cần tiền tố VITE_) =====
VITE_API_BASE=http://localhost:8080
