# ─────────────────────────────────────────────────────────────
# MTJOB — biến môi trường (copy sang server/.env và web/.env)
# ─────────────────────────────────────────────────────────────

# ===== Server =====
PORT=8080
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# JWT
JWT_SECRET=doi-thanh-mot-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=7d

# Tài khoản admin khởi tạo (script setup-sheet sẽ tạo nếu chưa có)
ADMIN_EMAIL=admin@mtjob.local
ADMIN_PASSWORD=Admin@2026

# Google service account (đường dẫn tới file JSON key)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Google Sheet làm CSDL chính (ID, không phải URL)
SHEET_DB_ID=

# Sheet nhân sự nguồn (để sync-members). Mặc định: sheet a đã share
SHEET_HR_SOURCE_ID=1v5AZh3cPOYhoE65i2Ndsl5JuJYgjS0z_rtVOxM199gE
SHEET_HR_SOURCE_GID=0

# ===== Gemini (trợ lý chat) =====
# Cách 1 (KHUYẾN NGHỊ — OAuth đăng nhập Google):
#   1. Tạo OAuth Client ID kiểu "Web application" trong Google Cloud Console.
#   2. Thêm Authorized redirect URI: http://localhost:8080/api/oauth2/callback (đổi domain khi prod).
#   3. Chạy:  npm run gemini-auth --prefix server  -> mở URL -> đồng ý
#      -> Google redirect về /api/oauth2/callback và hiển thị GEMINI_OAUTH_REFRESH_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:8080/api/oauth2/callback
GEMINI_OAUTH_REFRESH_TOKEN=

# Cách 2 (DỰ PHÒNG — API key AI Studio). Để trống nếu đã dùng OAuth ở trên.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cách 3 (chạy trên Mac qua cliproxyapi / proxy AI cục bộ):
#   Trỏ base URL vào proxy (đầu ra theo định dạng Gemini REST). Nếu proxy cần key thì điền GEMINI_API_KEY.
# GEMINI_BASE_URL=http://localhost:8317/v1beta

# ===== Web Push (VAPID) — sinh bằng: npx web-push generate-vapid-keys =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mtjob.local

# ===== Frontend (web/.env — Vite cần tiền tố VITE_) =====
VITE_API_BASE=http://localhost:8080
VITE_VAPID_PUBLIC_KEY=
